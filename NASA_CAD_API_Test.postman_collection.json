							"    pm.expect(jsonData).to.have.property(\"count\");\r",
							"    pm.expect(jsonData).to.have.property(\"fields\").that.is.an(\"array\");\r",
							"    pm.expect(jsonData).to.have.property(\"data\").that.is.an(\"array\");\r",
							"});\r",
							"\r",
							"// Test if the count matches the length of the data array\r",
							"pm.test(\"Count matches data array length\", function () {\r",
